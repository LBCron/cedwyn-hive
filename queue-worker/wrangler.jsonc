{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cedwyn-hive-github-queue",
  "main": "src/index.js",
  "compatibility_date": "2026-11-06",
  "workers_dev": true,
  "preview_urls": true,
  "durable_objects": {
    "bindings": [
      { "name": "ISSUE_LEASES", "class_name": "IssueLease" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["IssueLease"] }
  ],
  "vars": {
    "PUBLIC_REPOS": "unclehowell/cedwyn,unclehowell/cedwyn-hive,unclehowell/cedwyn-tithe-h3"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true }
  }
}
